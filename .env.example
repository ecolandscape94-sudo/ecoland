# Public URL: set your production domain, including https://
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: verified contact information (otherwise no fake contact links appear)
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS=
# Share the spreadsheet ONLY with this service account, as Editor
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Auth.js: Google OAuth, not the service account above
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Comma-separated Google account emails; Google must verify the email
ADMIN_EMAILS=
EDITOR_EMAILS=
# Server-only Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SMTP notifications: saved inquiries remain saved when delivery fails
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_NOTIFY_EMAIL=
# Required on Vercel for shared rate limiting, free tier is sufficient for small sites
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional analytics; loaded only after visitor consent
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
